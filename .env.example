# Copy to .env.local and fill in. Never commit real keys.

# Public origin of the site (used for Stripe success/cancel URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Which payment provider module to use (only "stripe" is implemented)
PAYMENT_PROVIDER=stripe

# Stripe TEST-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me
# From `stripe listen` (local) or the dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_replace_me
